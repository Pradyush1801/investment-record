# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/di_platform
# OR for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/di_platform

# JWT secret — generate a random 64-char string
JWT_SECRET=change_me_to_a_long_random_secret_string

# Token expiry
JWT_EXPIRES_IN=7d
INVITE_TOKEN_EXPIRES_HOURS=72

# App URL (used in invite emails)
FRONTEND_URL=http://localhost:5173

# Email — use your SMTP provider or Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@yourapp.com

# Server port
PORT=4000
